APP_NAME=Stratus Console
APP_ENV=development
API_PREFIX=/api/v1
MONGODB_URI=mongodb+srv://username:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=stratus
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=generate-with-documented-command
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PRIVATE_KEY_ENCRYPTION_KEY=generate-with-documented-command
FRONTEND_ORIGIN=http://localhost:5173
MULTIPASS_EXECUTABLE=multipass
MULTIPASS_DEFAULT_IMAGE=24.04
MAX_INSTANCE_CPUS=8
MAX_INSTANCE_MEMORY_MB=16384
MAX_INSTANCE_DISK_GB=100
MAX_TOTAL_INSTANCES=20
OPERATION_POLL_SECONDS=1
STATE_RECONCILE_SECONDS=15
AUTOSCALING_INTERVAL_SECONDS=30
ONE_TIME_SECRET_MINUTES=10
LOG_LEVEL=INFO
VM_PROVIDER=multipass
RUNTIME_ROOT=runtime
VOLUMES_ROOT=.stratus-volumes
