APP_NAME=LocalEC2
APP_ENV=development
API_PREFIX=/api/v1
MONGODB_URI=mongodb+srv://username:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=stratus
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=generate-with-documented-command
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PRIVATE_KEY_ENCRYPTION_KEY=generate-with-documented-command
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_FRONTEND_ORIGIN=http://localhost:5174
PLATFORM_ADMIN_EMAIL=owner@example.com
DEVELOPMENT_DEFAULT_ADMIN=true
MAX_INSTANCE_CPUS=8
MAX_INSTANCE_MEMORY_MB=16384
MAX_INSTANCE_DISK_GB=100
MAX_TOTAL_INSTANCES=20
OPERATION_POLL_SECONDS=1
OPERATION_WORKER_CONCURRENCY=8
STATE_RECONCILE_SECONDS=15
AUTOSCALING_INTERVAL_SECONDS=30
ONE_TIME_SECRET_MINUTES=10
LOG_LEVEL=INFO
NODE_OFFLINE_SECONDS=45
NODE_JOB_LEASE_SECONDS=1200
NODE_JOB_POLL_SECONDS=0.5
NODE_JOB_TIMEOUT_SECONDS=1200
RECOVERY_STORAGE_ROOT=./data/recovery-points
REPLICATION_POLL_SECONDS=15
# Node-agent settings (configure in /etc/localec2/agent.env on each node).
LOCAL_EC2_GC_INTERVAL_SECONDS=300
LOCAL_EC2_GC_GRACE_SECONDS=3600
# Reusable, pre-approved key. Optionally configure a tag after adding a
# matching tagOwner and Funnel node attribute to your tailnet policy.
# Never commit a real key or expose it through customer startup data.
TAILSCALE_REUSABLE_AUTH_KEY=
TAILSCALE_INSTANCE_TAG=
TAILSCALE_FUNNEL_TARGET_PORT=80
