LOCAL_EC2_API_URL=https://api.example.com/api/v1
LOCAL_EC2_NODE_ID=replace-with-node-id
LOCAL_EC2_NODE_TOKEN=replace-with-one-time-enrollment-token
LOCAL_EC2_STORAGE_ROOT=/var/lib/localec2
VAGRANT_EXECUTABLE=vagrant
VAGRANT_HOME=/var/lib/localec2/.vagrant.d
LIBVIRT_DEFAULT_URI=qemu:///system
HOME=/var/lib/localec2
