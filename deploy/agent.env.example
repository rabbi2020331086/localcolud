LOCAL_EC2_API_URL=https://api.example.com/api/v1
LOCAL_EC2_NODE_ID=replace-with-node-id
LOCAL_EC2_NODE_TOKEN=replace-with-one-time-enrollment-token
LOCAL_EC2_STORAGE_ROOT=/var/lib/localec2
LOCAL_EC2_AUTO_UPDATE=true
LOCAL_EC2_AUTO_UPDATE_INTERVAL_SECONDS=300
LOCAL_EC2_LAUNCH_TIMEOUT_SECONDS=1800
LOCAL_EC2_GC_INTERVAL_SECONDS=300
LOCAL_EC2_GC_GRACE_SECONDS=3600
VAGRANT_EXECUTABLE=vagrant
VAGRANT_HOME=/var/lib/localec2/.vagrant.d
LIBVIRT_DEFAULT_URI=qemu:///system
HOME=/var/lib/localec2
# Optional overrides for distributions with nonstandard OVMF paths:
# LOCAL_EC2_OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
# LOCAL_EC2_OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd
